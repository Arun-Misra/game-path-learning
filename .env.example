# PostgreSQL: create these databases and use a local role with access to both.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/gamified_learning?schema=public"
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/gamified_learning_test?schema=public"

# AI roadmap generation — no paid OpenAI account required.
# Option A (recommended for local development): install Ollama, run "ollama pull gemma4:e2b",
# then keep these defaults. Local Ollama does not need an API key.
AI_BASE_URL="http://127.0.0.1:11434/v1"
AI_API_KEY=""
AI_MODEL="gemma4:e2b"

# Option B: NVIDIA hosted NIM API (free for development/prototyping; quotas and model access apply).
# Create a key at https://build.nvidia.com/ and uncomment/configure these values:
# AI_BASE_URL="https://integrate.api.nvidia.com/v1"
# AI_API_KEY="your-nvidia-api-key"
# AI_MODEL="replace-with-a-model-enabled-in-your-nvidia-api-catalog"

# Other OpenAI-compatible hosted APIs can use AI_BASE_URL, AI_API_KEY, and AI_MODEL.
# API configuration
PORT=3000
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development
