# Configure a local PostgreSQL database before running migrations.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/gamified_learning?schema=public"

# Optional: use a separate, disposable migrated database for integration tests.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/gamified_learning_test?schema=public"

# Roadmap generation provider (keep the real key only in the ignored root .env).
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

# API configuration
PORT=3000
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development
