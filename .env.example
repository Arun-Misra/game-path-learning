
# PostgreSQL: create these databases and use a local role with access to both.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/gamified_learning?schema=public"
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/gamified_learning_test?schema=public"

# AI roadmap generation — no paid OpenAI account required for local Ollama.
# A single E4B model handles brief enhancement, roadmap generation, review, and revision.
# This avoids keeping/swapping a separate reviewer model in Ollama.
# Install with: ollama pull gemma4:e4b
AI_BASE_URL="http://127.0.0.1:11434/v1"
AI_API_KEY=""
AI_MODEL="gemma4:e4b"

# Option B: NVIDIA hosted NIM API (quotas and model access apply).
# For hosted providers, configure AI_BASE_URL, AI_API_KEY, and AI_MODEL.
# Create a key at https://build.nvidia.com/ and configure enabled model IDs:
# AI_BASE_URL="https://integrate.api.nvidia.com/v1"
# AI_API_KEY="your-nvidia-api-key"
# AI_MODEL="replace-with-a-model-enabled-in-your-nvidia-ai-catalog"
# AI_REVIEW_MODEL="replace-with-a-second-compatible-model"

# Other OpenAI-compatible hosted APIs can use AI_BASE_URL, AI_API_KEY, and AI_MODEL.
# API configuration
PORT=3000
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development