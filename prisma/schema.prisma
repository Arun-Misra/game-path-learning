generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LearningGoalStatus {
  DRAFT
  GENERATING
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum ExperienceLevel {
  BEGINNER
  SOME_EXPERIENCE
  EXPERIENCED
}

enum MissionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  SKIPPED
  EXPIRED
}

enum MissionType {
  LEARN
  PRACTICE
  REVIEW
  ASSESSMENT
}

enum TopicProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  MASTERED
}

enum ProjectMilestoneStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  name               String?
  passwordHash       String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  sessions           Session[]
  goals              LearningGoal[]
  missions           DailyMission[]
  completions        MissionCompletion[]
  xpTransactions     XpTransaction[]
  topicProgress      UserTopicProgress[]
  assessmentAttempts AssessmentAttempt[]
  achievements       UserAchievement[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model LearningGoal {
  id                  String             @id @default(cuid())
  userId              String
  title               String
  originalDescription String
  targetOutcome       String
  experienceLevel     ExperienceLevel
  minutesPerDay       Int
  daysPerWeek         Int
  targetDate          DateTime?
  status              LearningGoalStatus @default(DRAFT)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmaps            Roadmap[]
  missions            DailyMission[]

  @@index([userId, status])
  @@index([createdAt])
}

model Roadmap {
  id                       String         @id @default(cuid())
  learningGoalId           String
  version                  Int            @default(1)
  title                    String
  summary                  String
  learningBrief            Json?
  learningBriefConfirmedAt DateTime?
  generationState          String         @default("DRAFT")
  activatedAt              DateTime?
  createdAt                DateTime       @default(now())
  learningGoal             LearningGoal   @relation(fields: [learningGoalId], references: [id], onDelete: Cascade)
  topics                   RoadmapTopic[]
  missions                 DailyMission[]
  projectMilestones        ProjectMilestone[]

  @@unique([learningGoalId, version])
  @@index([learningGoalId, generationState])
}

model RoadmapTopic {
  id                 String              @id @default(cuid())
  roadmapId          String
  title              String
  description        String
  learningObjectives Json
  estimatedMinutes   Int
  position           Int
  roadmap            Roadmap             @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  prerequisites      TopicPrerequisite[] @relation("TopicPrerequisites")
  requiredBy         TopicPrerequisite[] @relation("TopicDependents")
  missions           DailyMission[]
  userProgress       UserTopicProgress[]
  assessment         TopicAssessment?

  @@unique([roadmapId, position])
  @@index([roadmapId])
}

model TopicPrerequisite {
  topicId        String
  prerequisiteId String
  topic          RoadmapTopic @relation("TopicPrerequisites", fields: [topicId], references: [id], onDelete: Cascade)
  prerequisite   RoadmapTopic @relation("TopicDependents", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@id([topicId, prerequisiteId])
  @@index([prerequisiteId])
}

model DailyMission {
  id                 String             @id @default(cuid())
  userId             String
  learningGoalId     String
  roadmapId          String
  topicId            String
  scheduledDate      DateTime           @db.Date
  segmentIndex       Int                @default(0)
  missionType        MissionType
  title              String
  description        String
  estimatedMinutes   Int
  completionCriteria Json
  status             MissionStatus      @default(SCHEDULED)
  createdAt          DateTime           @default(now())
  completedAt        DateTime?
  recoveredAt        DateTime?
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  learningGoal       LearningGoal       @relation(fields: [learningGoalId], references: [id], onDelete: Cascade)
  roadmap            Roadmap            @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  topic              RoadmapTopic       @relation(fields: [topicId], references: [id], onDelete: Cascade)
  completion         MissionCompletion?
  xpTransaction      XpTransaction?

  @@unique([userId, roadmapId, scheduledDate, topicId, segmentIndex])
  @@index([userId, scheduledDate, status])
  @@index([roadmapId, status, recoveredAt])
  @@index([learningGoalId, scheduledDate])
  @@index([topicId, status])
}

model ProjectMilestone {
  id             String                @id @default(cuid())
  roadmapId      String
  title          String
  description    String
  successCriteria Json
  position       Int
  status         ProjectMilestoneStatus @default(PLANNED)
  evidence       String?
  completedAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  roadmap        Roadmap               @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@unique([roadmapId, position])
  @@index([roadmapId, status])
}

model MissionCompletion {
  id          String       @id @default(cuid())
  userId      String
  missionId   String       @unique
  completedAt DateTime     @default(now())
  evidence    Json?
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission     DailyMission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@index([userId, completedAt])
}

model XpTransaction {
  id             String        @id @default(cuid())
  userId         String
  missionId      String?       @unique
  amount         Int
  reason         String
  idempotencyKey String        @unique
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission        DailyMission? @relation(fields: [missionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model UserTopicProgress {
  id             String              @id @default(cuid())
  userId         String
  topicId        String
  status         TopicProgressStatus @default(NOT_STARTED)
  masteryScore   Float?
  attempts       Int                 @default(0)
  lastActivityAt DateTime?
  updatedAt      DateTime            @updatedAt
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic          RoadmapTopic        @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([userId, status])
}

model TopicAssessment {
  id           String              @id @default(cuid())
  topicId      String              @unique
  title        String
  instructions String
  questions    Json
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  topic        RoadmapTopic        @relation(fields: [topicId], references: [id], onDelete: Cascade)
  attempts     AssessmentAttempt[]

  @@index([createdAt])
}

model AssessmentAttempt {
  id            String          @id @default(cuid())
  userId        String
  assessmentId  String
  answers       Json
  score         Float
  correctCount  Int
  questionCount Int
  passed        Boolean
  createdAt     DateTime        @default(now())
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessment    TopicAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([assessmentId, createdAt])
}

model UserAchievement {
  id             String   @id @default(cuid())
  userId         String
  achievementKey String
  unlockedAt     DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementKey])
  @@index([userId, unlockedAt])
}
